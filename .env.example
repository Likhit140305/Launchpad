# Neon Postgres (pooled for the app, direct for `prisma db push`). `neon link` writes both into .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Admin dashboard key (sent as the x-admin-key header). Falls back to "nxtwave-admin" if unset: set it before sharing.
ADMIN_KEY="change-me-to-a-long-secret"

# Optional: salt for hashing visitor IPs (rate limits and fraud flags). Defaults to ADMIN_KEY.
IP_SALT=""

# Optional: force the public origin used in share links (otherwise taken from the request host).
PUBLIC_URL=""
